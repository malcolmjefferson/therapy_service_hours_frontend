{
  "name": "therapy-service-hours-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings=0 && node scripts/check-no-hex.mjs",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "api:types": "openapi-typescript src/lib/api/openapi.yaml -o src/lib/api/schema.d.ts",
    "api:sync": "node scripts/api-sync.mjs",
    "api:types:check": "openapi-typescript src/lib/api/openapi.yaml -o src/lib/api/schema.d.ts --check",
    "api:drift": "node scripts/api-drift.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tanstack/react-query": "^5.104.1",
    "openapi-fetch": "^0.17.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.2",
    "msw": "^3.0.4",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
